<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="AirMirror.MainWindow"
        Width="960" Height="600" MinWidth="480" MinHeight="360"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="AirMirror">

    <!--
      窗口即画面:视频由原生视图渲染在窗口视图层级的最底部(兼作黑色背景,
      sink 自动按比例留黑边),Avalonia 内容透明叠加其上,悬浮层永远在视频之上。
      根 Grid 的 Transparent 背景用于命中测试(鼠标移动唤醒悬浮层、双击全屏)。
    -->
    <Grid x:Name="RootArea" Background="Transparent"
          PointerPressed="OnBackgroundPointerPressed">

        <!-- 空态引导:未连接时显示(按钮需命中测试,点击经 RootArea 冒泡,不影响双击全屏) -->
        <StackPanel x:Name="EmptyState" Spacing="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <PathIcon Data="{DynamicResource IconCast}" Width="44" Height="44"
                      Foreground="#40FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyStateTitle" Text="尚未开始接收"
                       FontSize="15" FontWeight="SemiBold" Foreground="#CCFFFFFF"
                       HorizontalAlignment="Center"/>
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="1. 确保 iPhone 与这台 Mac 连接同一 WiFi"
                           FontSize="12" Foreground="#99FFFFFF"/>
                <TextBlock Text="2. 打开 iPhone 控制中心 → 屏幕镜像"
                           FontSize="12" Foreground="#99FFFFFF"/>
                <TextBlock x:Name="GuideDeviceNameText" Text="3. 选择「AirMirror」"
                           FontSize="12" Foreground="#99FFFFFF"/>
            </StackPanel>
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock FontSize="11" Foreground="#66FFFFFF"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                           Text="搜不到设备时,请检查 系统设置 → 隐私与安全性 → 本地网络 中是否已允许本应用"/>
                <Button x:Name="LocalNetworkButton" Classes="secondary" FontSize="11"
                        Padding="12,4" HorizontalAlignment="Center"
                        Content="打开本地网络设置"
                        Click="OnOpenLocalNetworkSettings"/>
            </StackPanel>
        </StackPanel>

        <!-- 顶部悬浮栏:渐变遮罩 + 状态文字,兼作窗口拖拽区 -->
        <Border x:Name="TopBar" Classes="chrome" VerticalAlignment="Top" Height="64"
                PointerPressed="OnTitleBarPointerPressed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#8C000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock x:Name="StatusText" Text="AirMirror"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,11,0,0"
                       FontSize="13" FontWeight="Medium" Foreground="#E6FFFFFF"/>
        </Border>

        <!-- 底部悬浮工具栏:半透明药丸,连接后随鼠标静止自动隐藏 -->
        <Border x:Name="Toolbar" Classes="chrome"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                Background="#B31C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1"
                CornerRadius="999" Padding="8,6"
                BoxShadow="0 4 16 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

                <Button x:Name="MirrorToggleButton" Classes="pill-primary" Content="开始接收"
                        Click="OnMirrorToggleClicked" Margin="0,0,4,0"/>

                <Border Width="1" Height="18" Background="#26FFFFFF" Margin="4,0"
                        VerticalAlignment="Center"/>

                <Button x:Name="PinButton" Classes="pill-button" Opacity="0.45"
                        ToolTip.Tip="窗口置顶" Click="OnToggleTopmost">
                    <PathIcon Data="{DynamicResource IconPin}" Width="15" Height="15"
                              Foreground="#E6FFFFFF"/>
                </Button>
                <Button Classes="pill-button" ToolTip.Tip="全屏(双击画面也可切换)"
                        Click="OnToggleFullscreen">
                    <PathIcon Data="{DynamicResource IconMaximize}" Width="15" Height="15"
                              Foreground="#E6FFFFFF"/>
                </Button>
                <Button Classes="pill-button" ToolTip.Tip="无边框展示模式(ESC 退出)"
                        Click="OnEnterBorderless">
                    <PathIcon Data="{DynamicResource IconFrame}" Width="15" Height="15"
                              Foreground="#E6FFFFFF"/>
                </Button>

                <Border Width="1" Height="18" Background="#26FFFFFF" Margin="4,0"
                        VerticalAlignment="Center"/>

                <PathIcon Data="{DynamicResource IconVolume}" Width="14" Height="14"
                          Foreground="#99FFFFFF" Margin="6,0,2,0"/>
                <Slider x:Name="GainSlider" Minimum="0" Maximum="2" Value="1" Width="80"
                        VerticalAlignment="Center" ValueChanged="OnGainChanged"/>
                <TextBlock x:Name="GainText" FontSize="11" Width="34" Margin="2,0,0,0"
                           VerticalAlignment="Center" Foreground="#99FFFFFF" Text="100%"/>

                <Border Width="1" Height="18" Background="#26FFFFFF" Margin="4,0"
                        VerticalAlignment="Center"/>

                <!-- 设置(弹出面板) -->
                <Button x:Name="SettingsButton" Classes="pill-button" ToolTip.Tip="设置">
                    <PathIcon Data="{DynamicResource IconSettings}" Width="15" Height="15"
                              Foreground="#E6FFFFFF"/>
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <StackPanel Width="280" Spacing="10" Margin="4">
                                <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="设备名称(iPhone 屏幕镜像列表中显示的名字,接收中修改会自动重启接收)"/>
                                <TextBox x:Name="DeviceNameBox"/>
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="连接密码(留空则不需要密码;对新连接生效,接收中修改无需重启)"/>
                                <TextBox x:Name="PasswordBox" PlaceholderText="留空表示不需要密码"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="caption" VerticalAlignment="Center"
                                               Text="设备接入/断开时通知"/>
                                    <ToggleSwitch x:Name="NotifySwitch" Grid.Column="1"
                                                  OnContent="" OffContent=""/>
                                </Grid>
                                <TextBlock Classes="caption" Text="外观"/>
                                <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem>跟随系统</ComboBoxItem>
                                    <ComboBoxItem>浅色</ComboBoxItem>
                                    <ComboBoxItem>深色</ComboBoxItem>
                                </ComboBox>
                                <Button Classes="primary" Content="应用"
                                        HorizontalAlignment="Right"
                                        Click="OnApplySettings"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

            </StackPanel>
        </Border>

    </Grid>
</Window>
