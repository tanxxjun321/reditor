<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="REditor.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <!-- ============================================================ -->
        <!-- Design Token: 颜色                                           -->
        <!-- ============================================================ -->

        <!-- 品牌色（跨平台统一） -->
        <Color x:Key="TokenBrandPrimary">#007AFF</Color>
        <Color x:Key="TokenBrandPrimaryHover">#0062CC</Color>
        <Color x:Key="TokenBrandSecondary">#5856D6</Color>

        <!-- 浅色模式 Surface -->
        <SolidColorBrush x:Key="TokenSurfaceLight" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TokenSurfaceSidebarLight" Color="#F2F2F7"/>

        <!-- 深色模式 Surface -->
        <SolidColorBrush x:Key="TokenSurfaceDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TokenSurfaceSidebarDark" Color="#2A2A2A"/>

        <!-- 浅色模式边框 -->
        <SolidColorBrush x:Key="TokenBorderLight" Color="#E5E5E5"/>

        <!-- 深色模式边框 -->
        <SolidColorBrush x:Key="TokenBorderDark" Color="#383838"/>

        <!-- 浅色模式前景色 -->
        <SolidColorBrush x:Key="TokenForegroundPrimaryLight" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="TokenForegroundSecondaryLight" Color="#8E8E93"/>
        <SolidColorBrush x:Key="TokenForegroundTertiaryLight" Color="#E5E5EA"/>

        <!-- 深色模式前景色 -->
        <SolidColorBrush x:Key="TokenForegroundPrimaryDark" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TokenForegroundSecondaryDark" Color="#98989D"/>
        <SolidColorBrush x:Key="TokenForegroundTertiaryDark" Color="#3A3A3C"/>

        <!-- ============================================================ -->
        <!-- Design Token: 字体                                           -->
        <!-- ============================================================ -->
        <FontFamily x:Key="TokenFontFamily">SF Pro Text, Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto</FontFamily>
        <x:Double x:Key="TokenFontCaption">11</x:Double>
        <x:Double x:Key="TokenFontBody">13</x:Double>
        <x:Double x:Key="TokenFontTitle">16</x:Double>
        <x:Double x:Key="TokenFontDisplay">22</x:Double>

        <!-- ============================================================ -->
        <!-- Design Token: 间距                                           -->
        <!-- ============================================================ -->
        <Thickness x:Key="TokenSpacingXS">4</Thickness>
        <Thickness x:Key="TokenSpacingSM">8</Thickness>
        <Thickness x:Key="TokenSpacingMD">16</Thickness>
        <Thickness x:Key="TokenSpacingLG">24</Thickness>
        <Thickness x:Key="TokenSpacingXL">32</Thickness>

        <!-- ============================================================ -->
        <!-- Design Token: 圆角                                           -->
        <!-- ============================================================ -->
        <CornerRadius x:Key="TokenRadiusSM">4</CornerRadius>
        <CornerRadius x:Key="TokenRadiusMD">8</CornerRadius>
        <CornerRadius x:Key="TokenRadiusLG">12</CornerRadius>
        <CornerRadius x:Key="TokenRadiusXL">16</CornerRadius>
        <CornerRadius x:Key="TokenRadiusPill">999</CornerRadius>

        <!-- ============================================================ -->
        <!-- Design Token: 图标 (Lucide Icons PathGeometry)               -->
        <!-- ============================================================ -->
        <PathGeometry x:Key="IconPlus">M12 5L12 19M5 12L19 12</PathGeometry>
        <PathGeometry x:Key="IconMinus">M5 12L19 12</PathGeometry>
        <PathGeometry x:Key="IconX">M18 6L6 18M6 6L18 18</PathGeometry>
        <PathGeometry x:Key="IconSun">M12 17a5 5 0 100-10 5 5 0 000 10zM12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42</PathGeometry>
        <PathGeometry x:Key="IconMoon">M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z</PathGeometry>
        <PathGeometry x:Key="IconMonitor">M20 3H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V5a2 2 0 00-2-2zM8 21h8M12 17v4</PathGeometry>
        <PathGeometry x:Key="IconPalette">M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10c1.38 0 2.5-1.12 2.5-2.5c0-.61-.23-1.21-.64-1.67c-.08-.09-.13-.21-.13-.33c0-.28.22-.5.5-.5H16c3.04 0 5.5-2.46 5.5-5.5S19.04 6.5 16 6.5c-.28 0-.5-.22-.5-.5c0-.12.05-.24.13-.33c.46-.52.67-1.17.67-1.84C16.3 2.77 14.53 2 12 2zM7.5 10.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm3-4a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm5 0a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm3 4a1.5 1.5 0 100-3 1.5 1.5 0 000 3z</PathGeometry>
        <PathGeometry x:Key="IconSettings">M12.22 2h-.44a2 2 0 00-2 2v.18a2 2 0 01-1 1.73l-.43.25a2 2 0 01-2 0l-.15-.08a2 2 0 00-2.73.73l-.22.38a2 2 0 00.73 2.73l.15.1a2 2 0 011 1.72v.51a2 2 0 01-1 1.74l-.15.09a2 2 0 00-.73 2.73l.22.38a2 2 0 002.73.73l.15-.08a2 2 0 012 0l.43.25a2 2 0 011 1.73V20a2 2 0 002 2h.44a2 2 0 002-2v-.18a2 2 0 011-1.73l.43-.25a2 2 0 012 0l.15.08a2 2 0 002.73-.73l.22-.39a2 2 0 00-.73-2.73l-.15-.08a2 2 0 01-1-1.74v-.5a2 2 0 011-1.74l.15-.09a2 2 0 00.73-2.73l-.22-.38a2 2 0 00-2.73-.73l-.15.08a2 2 0 01-2 0l-.43-.25a2 2 0 01-1-1.73V4a2 2 0 00-2-2zM12 15.5A3.5 3.5 0 1012 8.5a3.5 3.5 0 000 7z</PathGeometry>
        <PathGeometry x:Key="IconFileText">M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8</PathGeometry>
        <PathGeometry x:Key="IconFolderOpen">M2 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2zM2 10h20</PathGeometry>
        <PathGeometry x:Key="IconSave">M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v13a2 2 0 01-2 2zM17 21v-8H7v8M7 3v5h8</PathGeometry>
        <PathGeometry x:Key="IconSunMoon">M12 3a6 6 0 009 9 9 9 0 11-9-9z</PathGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ============================================================ -->
        <!-- 可复用样式                                                   -->
        <!-- ============================================================ -->

        <!-- 卡片容器 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeWhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusLG}"/>
            <Setter Property="Padding" Value="{DynamicResource TokenSpacingLG}"/>
        </Style>

        <!-- 次级说明文字 -->
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource TokenFontCaption}"/>
        </Style>

        <!-- 强调色主按钮 -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusMD}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAltAccentBrush}"/>
        </Style>

        <!-- 图标按钮（工具栏操作） -->
        <Style Selector="Button.icon-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusMD}"/>
        </Style>
        <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        </Style>

        <!-- 侧边栏容器 -->
        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <!-- 侧边栏导航项 -->
        <Style Selector="ListBoxItem.nav-item">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusMD}"/>
            <Setter Property="FontSize" Value="{DynamicResource TokenFontBody}"/>
        </Style>
        <Style Selector="ListBoxItem.nav-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        </Style>
        <Style Selector="ListBoxItem.nav-item:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
        </Style>
        <Style Selector="ListBoxItem.nav-item:selected">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 工具栏容器 -->
        <Style Selector="Border.toolbar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <!-- 状态栏容器 -->
        <Style Selector="Border.statusbar">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="16,6"/>
        </Style>
    </Application.Styles>
</Application>
