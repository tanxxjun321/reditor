<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="REditor.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <!-- ============================================================ -->
        <!-- Design Token: 阴影（深浅色通用）                               -->
        <!-- ============================================================ -->
        <x:String x:Key="TokenShadowXS">0 1px 2px 0 #0000000A</x:String>
        <x:String x:Key="TokenShadowSM">0 1px 3px 0 #0000000F, 0 1px 2px 0 #0000000A</x:String>
        <x:String x:Key="TokenShadowMD">0 4px 8px 0 #0000000F, 0 2px 4px 0 #0000000A</x:String>
        <x:String x:Key="TokenShadowLG">0 12px 24px 0 #00000014</x:String>

        <!-- ============================================================ -->
        <!-- Design Token: 字体                                            -->
        <!-- ============================================================ -->
        <FontFamily x:Key="TokenFontFamily">SF Pro Text, Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto</FontFamily>
        <FontFamily x:Key="TokenFontMono">SF Mono, JetBrains Mono, Cascadia Code, Consolas, monospace</FontFamily>
        <x:Double x:Key="TokenFontCaption">11</x:Double>
        <x:Double x:Key="TokenFontBody">13</x:Double>
        <x:Double x:Key="TokenFontTitle">16</x:Double>
        <x:Double x:Key="TokenFontDisplay">22</x:Double>

        <!-- ============================================================ -->
        <!-- Design Token: 间距                                            -->
        <!-- ============================================================ -->
        <x:Double x:Key="TokenSpacingXS">4</x:Double>
        <x:Double x:Key="TokenSpacingSM">8</x:Double>
        <x:Double x:Key="TokenSpacingMD">16</x:Double>
        <x:Double x:Key="TokenSpacingLG">24</x:Double>
        <x:Double x:Key="TokenSpacingXL">32</x:Double>
        <x:Double x:Key="TokenSpacing2XL">48</x:Double>

        <!-- ============================================================ -->
        <!-- Design Token: Padding / Margin (Thickness)                    -->
        <!-- ============================================================ -->
        <Thickness x:Key="TokenPaddingCard">24</Thickness>
        <Thickness x:Key="TokenPaddingSm">12,8</Thickness>
        <Thickness x:Key="TokenPaddingXs">8</Thickness>
        <Thickness x:Key="TokenMarginPage">48</Thickness>

        <!-- ============================================================ -->
        <!-- Design Token: 圆角                                            -->
        <!-- ============================================================ -->
        <CornerRadius x:Key="TokenRadiusSM">4</CornerRadius>
        <CornerRadius x:Key="TokenRadiusMD">6</CornerRadius>
        <CornerRadius x:Key="TokenRadiusLG">8</CornerRadius>
        <CornerRadius x:Key="TokenRadiusXL">12</CornerRadius>
        <CornerRadius x:Key="TokenRadiusPill">999</CornerRadius>

        <!-- ============================================================ -->
        <!-- Design Token: 品牌色（深浅色通用的高对比度蓝）                 -->
        <!-- ============================================================ -->
        <Color x:Key="TokenAccentColor">#2563EB</Color>
        <Color x:Key="TokenAccentHoverColor">#1D4ED8</Color>
        <Color x:Key="TokenAccentPressedColor">#1E40AF</Color>

        <!-- ============================================================ -->
        <!-- Design Token: 图标 (Lucide Icons PathGeometry)               -->
        <!-- ============================================================ -->
        <PathGeometry x:Key="IconMonitor">M20 3H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V5a2 2 0 00-2-2zM8 21h8M12 17v4</PathGeometry>
        <PathGeometry x:Key="IconSettings">M12.22 2h-.44a2 2 0 00-2 2v.18a2 2 0 01-1 1.73l-.43.25a2 2 0 01-2 0l-.15-.08a2 2 0 00-2.73.73l-.22.38a2 2 0 00.73 2.73l.15.1a2 2 0 011 1.72v.51a2 2 0 01-1 1.74l-.15.09a2 2 0 00-.73 2.73l.22.38a2 2 0 002.73.73l.15-.08a2 2 0 012 0l.43.25a2 2 0 011 1.73V20a2 2 0 002 2h.44a2 2 0 002-2v-.18a2 2 0 011-1.73l.43-.25a2 2 0 012 0l.15.08a2 2 0 002.73-.73l.22-.39a2 2 0 00-.73-2.73l-.15-.08a2 2 0 01-1-1.74v-.5a2 2 0 011-1.74l.15-.09a2 2 0 00.73-2.73l-.22-.38a2 2 0 00-2.73-.73l-.15.08a2 2 0 01-2 0l-.43-.25a2 2 0 01-1-1.73V4a2 2 0 00-2-2zM12 15.5A3.5 3.5 0 1012 8.5a3.5 3.5 0 000 7z</PathGeometry>
        <PathGeometry x:Key="IconVolume">M11 5L6 9H2v6h4l5 4V5zM15.54 8.46a5 5 0 010 7.07M19.07 4.93a10 10 0 010 14.14</PathGeometry>
        <PathGeometry x:Key="IconMaximize">M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3</PathGeometry>
        <PathGeometry x:Key="IconPin">M12 17v5M9 10.76a2 2 0 01-1.11 1.79l-1.78.9A2 2 0 005 15.24V16a1 1 0 001 1h12a1 1 0 001-1v-.76a2 2 0 00-1.11-1.79l-1.78-.9A2 2 0 0115 10.76V6h1a2 2 0 000-4H8a2 2 0 000 4h1Z</PathGeometry>
        <PathGeometry x:Key="IconFrame">M22 6H2M22 18H2M6 2v20M18 2v20</PathGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ============================================================ -->
        <!-- 可复用组件样式                                                -->
        <!-- ============================================================ -->

        <!-- 卡片容器 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusLG}"/>
            <Setter Property="Padding" Value="{DynamicResource TokenPaddingCard}"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #0F000000, 0 1 2 0 #0A000000"/>
        </Style>

        <!-- 次级说明文字 -->
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource TokenFontCaption}"/>
        </Style>

        <!-- 强调色主按钮 -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusMD}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAltAccentBrush}"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>

        <!-- 次级按钮 -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusMD}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>

        <!-- 图标按钮（工具栏操作） -->
        <Style Selector="Button.icon-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="{DynamicResource TokenPaddingXs}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusMD}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
        </Style>

        <!-- 状态栏容器 -->
        <Style Selector="Border.statusbar">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeLowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="16,6"/>
        </Style>

        <!-- 悬浮工具栏:图标按钮(深色药丸上的白色按钮,与主题无关) -->
        <Style Selector="Button.pill-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusPill}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pill-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF"/>
        </Style>
        <Style Selector="Button.pill-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3DFFFFFF"/>
        </Style>

        <!-- 悬浮工具栏:主按钮(开始/停止接收) -->
        <Style Selector="Button.pill-primary">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="CornerRadius" Value="{DynamicResource TokenRadiusPill}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pill-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAltAccentBrush}"/>
        </Style>

        <!-- 悬浮层的淡入淡出 -->
        <Style Selector="Border.chrome">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- 输入框聚焦态高亮 -->
        <Style Selector="TextBox:focus /template/ Border#BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
        </Style>
    </Application.Styles>
</Application>
