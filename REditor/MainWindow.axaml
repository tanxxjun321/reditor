<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:airplay="using:REditor.AirPlay"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="REditor.MainWindow"
        Width="960" Height="600" MinWidth="600" MinHeight="440"
        Title="REditor">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ========== 自定义标题栏 ========== -->
        <Border x:Name="TitleBar" Height="36"
                Background="Transparent"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto">
                <!-- 标题 -->
                <TextBlock Grid.Column="0" Text="REditor"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="13" FontWeight="Medium"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                <!-- 工具栏按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton"
                            Classes="icon-button"
                            Click="OnToggleTheme">
                        <PathIcon Data="{DynamicResource IconSunMoon}"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 主体区域 ========== -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">

            <!-- 侧边栏 -->
            <Border x:Name="Sidebar" Classes="sidebar">
                <DockPanel>
                    <!-- Logo + 应用名 -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,48,20,16">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                HorizontalAlignment="Left">
                            <PathIcon Data="{DynamicResource IconFileText}"
                                      Width="20" Height="20" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="REditor" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="跨平台文本编辑器" FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- 导航菜单 -->
                    <ListBox x:Name="NavList" Classes="nav-list" Background="Transparent" BorderThickness="0"
                             Margin="0,8" SelectionChanged="OnNavSelectionChanged">
                        <ListBoxItem Classes="nav-item" IsSelected="True">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{DynamicResource IconFileText}" Width="16" Height="16"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Text="编辑" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Classes="nav-item">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{DynamicResource IconFolderOpen}" Width="16" Height="16"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Text="文件" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Classes="nav-item">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{DynamicResource IconSettings}" Width="16" Height="16"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Text="设置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Classes="nav-item">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{DynamicResource IconMonitor}" Width="16" Height="16"
                                          Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Text="投屏" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 主内容区：编辑器 -->
            <ScrollViewer Grid.Column="1" x:Name="EditorPage">
                <StackPanel MaxWidth="720" Margin="48" Spacing="24">

                    <Border Classes="card">
                        <StackPanel Spacing="16">
                            <TextBlock Text="欢迎使用" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       FontSize="13" LineHeight="20"
                                       Text="REditor 是一个基于 Avalonia + .NET 的跨平台桌面编辑器，支持 macOS 和 Windows，具备现代化的界面设计。"/>
                            <TextBox x:Name="InputBox" PlaceholderText="在这里输入一些文字…"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary" Content="确定" Click="OnGreetClicked"/>
                                <Button Classes="secondary" Content="清空" Click="OnClearClicked"/>
                            </StackPanel>
                            <Border x:Name="OutputCard" IsVisible="False"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                    CornerRadius="6" Padding="14,12">
                                <TextBlock x:Name="OutputText" TextWrapping="Wrap" FontSize="15"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <Border Width="36" Height="36" CornerRadius="8"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                        HorizontalAlignment="Left">
                                    <PathIcon Data="{DynamicResource IconMonitor}" Width="18" Height="18"
                                              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="跨平台" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Classes="caption" FontSize="12" TextWrapping="Wrap"
                                           Text="Windows、macOS、Linux 共用一套代码"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <Border Width="36" Height="36" CornerRadius="8"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                        HorizontalAlignment="Left">
                                    <PathIcon Data="{DynamicResource IconPalette}" Width="18" Height="18"
                                              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="现代主题" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Classes="caption" FontSize="12" TextWrapping="Wrap"
                                           Text="Vibrancy 毛玻璃 + Fluent 设计语言"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="8">
                                <Border Width="36" Height="36" CornerRadius="8"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                        HorizontalAlignment="Left">
                                    <PathIcon Data="{DynamicResource IconSunMoon}" Width="18" Height="18"
                                              Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="深浅色模式" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Classes="caption" FontSize="12" TextWrapping="Wrap"
                                           Text="自动跟随系统，支持手动切换"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 主内容区：iPhone 投屏 -->
            <Grid Grid.Column="1" x:Name="MirrorPage" IsVisible="False" RowDefinitions="Auto,*">

                <!-- 控制栏 -->
                <Border Classes="card" Margin="24,24,24,0" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="MirrorToggleButton" Classes="primary" Content="开始接收"
                                Click="OnMirrorToggleClicked" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="MirrorStatusText" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                       Text="未启动"/>
                            <TextBlock Classes="caption" FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Text="启动后,iPhone 控制中心 → 屏幕镜像 → 选择「REditor」"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="MirrorResolutionText" Classes="caption"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Grid>
                </Border>

                <!-- 视频区 -->
                <Border Grid.Row="1" Classes="card" Margin="24" Padding="0" ClipToBounds="True">
                    <airplay:AirPlayVideoHost x:Name="VideoHost"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ========== 底部状态栏 ========== -->
        <Border Grid.Row="2" Classes="statusbar">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="FooterText" Classes="caption" VerticalAlignment="Center"/>
                    <TextBlock Classes="caption" VerticalAlignment="Center" Text="UTF-8"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16">
                    <TextBlock Classes="caption" VerticalAlignment="Center" Text="Ln 1, Col 1"/>
                    <TextBlock Classes="caption" VerticalAlignment="Center" Text="Avalonia 12"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
